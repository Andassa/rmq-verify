<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!-- Tests and benchmarks are not public API: Javadoc and method length rules do not apply. -->
<suppressions>
  <suppress files="[\\/]src[\\/]test[\\/]" checks="MissingJavadoc(Type|Method)|JavadocMethod|MethodLength|ParameterNumber"/>
  <suppress files="[\\/]rmq-verify-jmh[\\/]" checks="MissingJavadoc(Type|Method)|JavadocMethod"/>
  <suppress files="[\\/]target[\\/]generated-" checks=".*"/>
</suppressions>
