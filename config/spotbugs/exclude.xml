<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every exclusion must name the exact pattern and explain why it is a false positive.
  Blanket exclusions by package are not accepted.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
  <!-- picocli injects option fields reflectively; they are never read before parsing completes. -->
  <Match>
    <Package name="io.github.andassa.rmqverify.cli"/>
    <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR,NP_UNWRITTEN_FIELD"/>
  </Match>
  <!--
    Adapters receive their collaborators (clients, controllers, recorders) through the constructor.
    Keeping a reference to an injected service is dependency injection, not exposure of mutable
    value state; value types in the model are immutable records and are not matched here.
  -->
  <Match>
    <Or>
      <Package name="io.github.andassa.rmqverify.cluster"/>
      <Package name="io.github.andassa.rmqverify.workload"/>
      <Package name="~io\.github\.andassa\.rmqverify\.workload\..*"/>
      <Package name="io.github.andassa.rmqverify.nemesis"/>
      <Package name="io.github.andassa.rmqverify.report"/>
      <Package name="io.github.andassa.rmqverify.cli"/>
    </Or>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    The single place that starts processes. Commands are argument lists (no shell), every container
    name is validated against NodeSpec.SAFE_NAME and every other argument is built from constants or
    validated values. See docs/THREAT_MODEL.md, threat T3.
  -->
  <Match>
    <Class name="io.github.andassa.rmqverify.cluster.SystemProcessRunner"/>
    <Bug pattern="COMMAND_INJECTION"/>
  </Match>
  <!--
    Every log line is emitted as JSON by the Logstash encoder (logback.xml of the CLI), which escapes
    CR and LF, so external text cannot forge log entries. Messages of external origin also go
    through cluster.Logs.safe, which bounds their length.
  -->
  <Match>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>
  <!--
    RunReport and ResultsPage assemble HTML and SVG from strings. Every value that comes from data
    goes through Html.escape (or RunReport.text for Markdown); the SVG fragments come from Svg, which
    escapes all its text. Covered by ReportRenderingTest.htmlIsSelfContainedAndEscaped.
  -->
  <Match>
    <Package name="io.github.andassa.rmqverify.report"/>
    <Bug pattern="POTENTIAL_XML_INJECTION"/>
  </Match>
  <!-- JMH state is initialised in @Setup methods, by design of the benchmark lifecycle. -->
  <Match>
    <Class name="io.github.andassa.rmqverify.jmh.CheckerBenchmark"/>
    <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
  </Match>
  <!-- Code generated by the JMH annotation processor. -->
  <Match>
    <Package name="~io\.github\.andassa\.rmqverify\.jmh\.jmh_generated.*"/>
  </Match>
</FindBugsFilter>
