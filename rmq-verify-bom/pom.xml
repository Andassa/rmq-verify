<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bill of materials for consumers who embed rmq-verify modules. It deliberately has no parent so
  that importing it never drags the build and quality configuration of this repository along.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.andassa</groupId>
  <artifactId>rmq-verify-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>rmq-verify :: BOM</name>
  <description>Aligned versions of every rmq-verify module.</description>
  <url>https://github.com/Andassa/rmq-verify</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <properties>
    <project.build.outputTimestamp>2026-10-24T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.andassa</groupId>
        <artifactId>rmq-verify-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.andassa</groupId>
        <artifactId>rmq-verify-checker</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.andassa</groupId>
        <artifactId>rmq-verify-workload</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.andassa</groupId>
        <artifactId>rmq-verify-cluster</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.andassa</groupId>
        <artifactId>rmq-verify-nemesis</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.andassa</groupId>
        <artifactId>rmq-verify-report</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.andassa</groupId>
        <artifactId>rmq-verify-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-site-plugin</artifactId>
          <version>3.22.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
